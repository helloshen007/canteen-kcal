# 密钥只在安全设置或本地 .env 中填写，不提交 .env。
VLM_PROVIDER=openai
VLM_BASE_URL=https://api.deepseek.com
VLM_MODEL=deepseek-flash
VLM_API_KEY=
VLM_DISABLE_THINKING=1

# 第三阶段 Docker Web；默认仅在服务器本机监听，可用 SSH 转发访问。
APP_BIND=127.0.0.1
APP_PORT=8080
# 配置 HTTPS 入口后设为 1。
COOKIE_SECURE=0
# 不填写 APP_SECRET_KEY 时自动生成并保存在 state 持久卷；如设置须至少 32 字符。
